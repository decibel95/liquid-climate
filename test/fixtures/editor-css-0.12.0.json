{
  "source": "git show fce593e:src/editor/liquid-climate-card-editor.ts (Liquid Climate 0.12.0 editor styles); top-level rules in order, @media blocks left out",
  "rules": [
    ":host{display:block;color:var(--primary-text-color)}",
    ".tabrow{display:flex;align-items:center;border-bottom:1px solid var(--divider-color)}",
    ".tabs{display:flex;flex:1 1 auto;min-width:0;gap:4px}",
    ".tabs button{flex:0 1 auto;min-width:0;min-height:44px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 14px;border:none;background:none;color:var(--secondary-text-color);font:inherit;font-weight:500;cursor:pointer;box-shadow:inset 0 -2px 0 transparent}",
    ".tabs button.on{color:var(--primary-text-color);box-shadow:inset 0 -2px 0 var(--primary-color)}",
    "button:focus-visible, input:focus-visible, select:focus-visible{outline:2px solid var(--primary-color);outline-offset:2px}",
    ".body{display:flex;flex-direction:column;gap:16px;padding:18px 2px}",
    ".field{display:flex;flex-direction:column;gap:6px}",
    ".lbl{font-size:12px;font-weight:500;color:var(--secondary-text-color)}",
    ".lbl.range{display:flex;justify-content:space-between}",
    ".hint{font-size:12px;color:var(--secondary-text-color)}",
    ".hint.pad{padding-top:8px}",
    "input[type='text'], select{min-height:40px;box-sizing:border-box;border-radius:10px;border:1px solid var(--divider-color);background:var(--card-background-color);color:var(--primary-text-color);font:inherit;padding:0 12px}",
    ".note{display:flex;align-items:center;gap:12px;border-radius:12px;padding:10px 12px;font-size:13px;line-height:1.45}",
    ".note.warn{background:rgba(255, 176, 103, 0.12);border:1px solid rgba(255, 176, 103, 0.4)}",
    ".note.info{background:rgba(90, 176, 255, 0.1);border:1px solid rgba(90, 176, 255, 0.35)}",
    ".note span{flex:1}",
    ".row{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--divider-color)}",
    ".grow{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}",
    ".name{font-size:14px;font-weight:500}",
    ".val{font-size:13px;color:var(--secondary-text-color);white-space:nowrap}",
    ".change{padding:6px 0}",
    ".group{display:contents}",
    ".change{display:grid;grid-template-columns:1.4fr 1fr;gap:6px}",
    ".change input{width:100%}",
    "button.ghost, button.solid, button.pill{font:inherit;font-size:13px;cursor:pointer;color:var(--primary-text-color);border-radius:18px;border:1px solid var(--divider-color);background:transparent;padding:0 14px;min-height:34px}",
    "button.small{min-height:30px;padding:0 10px;font-size:12px}",
    "button.dashed{align-self:flex-start;border-style:dashed}",
    "button.solid{background:#ffb067;border-color:#ffb067;color:#1b1206;font-weight:600}",
    "button.pill.on{background:var(--primary-color);border-color:var(--primary-color);color:var(--text-primary-color, #fff)}",
    ".chiprow{display:flex;flex-wrap:wrap;gap:6px}",
    ".seg{display:flex;gap:4px;padding:3px;border-radius:12px;border:1px solid var(--divider-color)}",
    ".seg button{flex:1;min-width:0;padding:0 6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-height:34px;border-radius:9px;border:none;background:transparent;color:var(--secondary-text-color);font:inherit;font-size:13px;cursor:pointer}",
    ".seg button.on{background:var(--primary-color);color:var(--text-primary-color, #fff)}",
    ".sw{width:42px;height:26px;flex:none;border-radius:13px;border:none;padding:0;position:relative;cursor:pointer;background:var(--divider-color);transition:background-color 0.25s}",
    ".sw.on{background:var(--primary-color)}",
    ".sw:disabled{opacity:0.4;cursor:default}",
    ".sw span{position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left 0.25s}",
    ".sw.on span{left:19px}",
    ".statusrow{display:grid;grid-template-columns:1.4fr 1fr 1fr auto;gap:6px}",
    ".vh{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}",
    ".actionsbox{grid-column:1 / -1;display:flex;flex-direction:column;gap:6px;padding:0 0 8px}",
    ".actionrow{display:grid;grid-template-columns:1fr auto;gap:6px;align-items:center}",
    ".hint.warn{grid-column:1 / -1;display:flex;align-items:center;gap:4px;color:var(--primary-text-color)}",
    ".hint.warn ha-icon{--mdc-icon-size:16px;color:var(--warning-color, #b45309)}",
    ".actionid{font-size:13px;overflow:hidden;text-overflow:ellipsis}",
    ".hint-row{display:flex;align-items:center;justify-content:space-between;font-size:13px}",
    ".lblrow{display:flex;align-items:center;justify-content:space-between;min-height:44px}",
    ".sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}",
    ".help{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;flex:none;width:44px;min-height:44px;margin-left:auto;color:var(--secondary-text-color);font-size:13px;font-weight:600;text-decoration:none}",
    ".help:focus-visible{outline:2px solid var(--primary-color);outline-offset:-4px;border-radius:10px}",
    ".foot button{min-height:44px}",
    ".foot{display:flex;padding-top:10px;border-top:1px solid var(--divider-color)}"
  ]
}
