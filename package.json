{
  "name": "liquid-climate",
  "version": "0.12.2",
  "description": "Liquid Climate: glass dial, tile, badge and cluster for Home Assistant climate entities, water heaters and humidifiers",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decibel95/liquid-climate.git"
  },
  "homepage": "https://decibel95.github.io/liquid-climate",
  "bugs": {
    "url": "https://github.com/decibel95/liquid-climate/issues"
  },
  "scripts": {
    "dev": "vite --port 5199 --open /dev/",
    "build": "vite build",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:typecheck": "tsc --noEmit -p docs/.vitepress",
    "media": "node scripts/media/run.mjs",
    "pixel": "node scripts/pixel/run.mjs check",
    "pixel:update": "node scripts/pixel/run.mjs update",
    "e2e": "playwright test -c test/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@decibel95/liquid-core": "0.3.0",
    "lit": "3.2.1"
  },
  "devDependencies": {
    "@mdi/js": "7.4.47",
    "ffmpeg-static": "5.3.0",
    "happy-dom": "15.11.7",
    "playwright": "1.65.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitepress": "1.6.4",
    "vitest": "2.1.8",
    "vue": "3.5.45"
  }
}
